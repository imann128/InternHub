PORT=5000
NODE_ENV=development

DB_HOST=
DB_PORT=5432
DB_NAME=
# DB_USER/DB_PASSWORD are what the RUNNING SERVER connects as. In production
# this should be the restricted `interns_app` role from
# backend/src/config/roles.sql — NOT a superuser/table-owner role. That role
# only has SELECT/INSERT/UPDATE/DELETE, no CREATE/ALTER/DROP, so a SQL
# injection bug or a stray raw query can never touch schema.
DB_USER=interns_app
DB_PASSWORD=
# Caps concurrent connections the server pool opens — see config/db.js.
DB_POOL_MAX=20

# Read ONLY by `node src/config/migrate.js`, never by the running server.
# Set these to the `interns_owner` role from roles.sql (has DDL rights).
# Prefer setting these in the shell/CI environment you run migrations from
# rather than this same .env — the server process never needs the owner
# password, so it shouldn't be sitting in a file it loads.
DB_MIGRATE_USER=interns_owner
DB_MIGRATE_PASSWORD=

JWT_SECRET=
ADMIN_SIGNUP_KEY=

# AES-256-GCM key used to encrypt submission files and chat attachments at
# rest (see utils/fileCrypto.js) — 64 hex characters (32 bytes). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every previously-uploaded file permanently
# undecryptable — back it up the same way you'd back up a database password.
FILE_ENCRYPTION_KEY=

# How long after an intern is soft-deleted their submission files and chat
# attachments are permanently removed from disk (see services/retentionService.js).
# The intern/task/submission rows themselves are kept for audit history —
# only the file content and its DB references are deleted.
FILE_RETENTION_DAYS=45

# Access token: short-lived JWT, delivered via HttpOnly cookie.
ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh token: long-lived opaque token, delivered via HttpOnly cookie
# scoped to /api/auth, hashed at rest in the sessions table.
REFRESH_TOKEN_EXPIRES_DAYS=30

# Must exactly match the frontend's origin (scheme + host + port) — used for
# both the CORS allowlist and is implicitly what the cookies' SameSite=strict
# policy is evaluated against. In production, set this to your deployed
# frontend URL (e.g. https://portal.yourcompany.com).
FRONTEND_URL=http://localhost:3000

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Used server-side only for the portal AI assistant and task description
# enhancement (see controllers/aiController.js). Never expose this as a
# REACT_APP_* frontend variable -- those get bundled into the built JS and
# are readable by anyone who opens dev tools on the deployed site.
GROQ_API_KEY=

# Per-org Slack config now lives on the organizations table
# (slack_bot_token/slack_channel_id/slack_enabled) — these env vars are only
# used as a fallback/default where noted in slackService.js.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

INTERN_PORTAL_URL=http://localhost:3000/intern/login
